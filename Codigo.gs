function extrairCNAE(texto) {
  if (!texto) return null;
  var limpo = String(texto).replace(/[\.\/\-]/g, '');
  var match = limpo.match(/\d{7}/);
  return match ? match[0] : null;
}

function validarCNAE(cnae) {
  var codigo = String(cnae || '').replace(/\D/g, '').substring(0, 7);
  if (!codigo || codigo.length < 7) {
    return { cnae: codigo, valido: false, simples_nacional: false, porte: "DEMAIS", regime: "CNAE invalido ou nao informado", erro: "CNAE deve ter 7 digitos" };
  }
  var elegivel = SIMPLES_PERMITIDOS.has(codigo);
  return {
    cnae: codigo,
    valido: true,
    simples_nacional: elegivel,
    porte: elegivel ? "ME/EPP" : "DEMAIS",
    regime: elegivel ? "Simples Nacional" : "Lucro Presumido ou Real",
    observacao: elegivel ? "CNAE permite Simples Nacional. ME ate R$360k/ano, EPP ate R$4,8M/ano." : "CNAE nao permite Simples Nacional."
  };
}

function doGet(e) {
  var params = e.parameter || {};
  var cnae = params.cnae || params.CNAE || '';
  if (cnae.length > 7) cnae = extrairCNAE(cnae) || cnae;
  var resultado = validarCNAE(cnae);
  return ContentService.createTextOutput(JSON.stringify(resultado)).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  var resultado;
  try {
    var body = JSON.parse(e.postData.contents || '{}');
    var cnae = body.cnae || body.CNAE || '';
    if (cnae.length > 7) cnae = extrairCNAE(cnae) || cnae;
    resultado = validarCNAE(cnae);
  } catch (err) {
    resultado = { cnae: '', valido: false, simples_nacional: false, porte: "DEMAIS", regime: "Erro ao processar", erro: err.message };
  }
  return ContentService.createTextOutput(JSON.stringify(resultado)).setMimeType(ContentService.MimeType.JSON);
}